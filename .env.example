NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI provider failover order: Groq -> Cerebras -> OpenRouter.
# Anthropic Claude is optional and is used only for detected large/complex tasks.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Appo AI App Builder
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=32000
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Added for zero-cost value-adds (One-Click GitHub Export)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Error monitoring (Sentry) — required before launch, see Pre-Launch Checklist
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Phase 13 — Paddle checkout
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BUSINESS=

# ============================================================
# Phase 21 — transactional email (Resend)
# ============================================================
# Server-side only. RESEND_API_KEY must NEVER be given a NEXT_PUBLIC_
# prefix — src/lib/email/resend.ts is guarded with `import "server-only"`
# so an accidental client import fails the build rather than shipping the
# key to the browser. Without RESEND_API_KEY the app runs normally and
# every send is recorded as "skipped" instead of failing an auth flow.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Appo <notifications@appo.app>
APPO_SUPPORT_EMAIL=support@appo.app

# Absolute origin used to build links inside emails and OG metadata.
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Salt for hashing IP addresses in audit_logs. Set an independent random
# value in production; it falls back to the service-role key so that
# hashes are at least not globally predictable.
APPO_IP_HASH_SALT=

# debug | info | warn | error. Defaults to info in production.
APPO_LOG_LEVEL=
